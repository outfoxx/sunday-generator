#%RAML 1.0 Library
uses:
  sunday: https://outfoxx.github.io/sunday-generator/sunday.raml

(sunday.placement):
  kotlin:
    models:
      package: io.example.library
  swift:
    models:
      module: LibraryModels
  typescript:
    models:
      module: library-models

types:
  Test:
    type: object
    properties:
      libraryValue: string
