#%RAML 1.0
title: Target Overrides API
uses:
  sunday: https://outfoxx.github.io/sunday-generator/sunday.raml
mediaType:
- application/json
(sunday.placement):
  kotlin:
    package: io.example.api
    client:
      package: io.example.client
      models:
        package: io.example.client.models
    server:
      package: io.example.server
      models:
        package: io.example.server.models
    models:
      package: io.example.models
  swift:
    module: TargetAPI
    models:
      module: TargetModels
  typescript:
    module: services
    models:
      module: models

types:
  User:
    (sunday.placement):
      kotlin:
        package: io.example.custom.models
      swift:
        module: UserModels
      typescript:
        module: user-models
    (sunday.kotlinType): io.example.custom.UserValue
    (sunday.kotlinType:client): io.example.client.UserValue
    (sunday.kotlinType:server): io.example.server.UserValue
    (sunday.swiftType): UserModels.UserValue
    (sunday.typeScriptType): UserValue
    type: object
    properties:
      id: string
      displayName:
        type: string
        (sunday.kotlinImplementation):
          code: 'return %T::class.qualifiedName + %S'
          parameters:
          - type: Type
            value: kotlin.String
          - type: String
            value: '-display'
        (sunday.swiftImplementation):
          code: 'return %T(describing: %T.self) + %S'
          parameters:
          - type: Type
            value: Swift.String
          - type: Type
            value: Foundation.Data
          - type: String
            value: '-display'
        (sunday.typeScriptImplementation):
          code: 'return %T.name + %S'
          parameters:
          - type: Type
            value: UserValue@@user-models
          - type: String
            value: '-display'

  UserPreference:
    (sunday.nested):
      enclosedIn: User
      name: Preference
    type: object
    properties:
      theme: string

  UserPreference-Option:
    (sunday.nested): dashed
    type: object
    properties:
      value: string

  UserPatch:
    (sunday.patchable): true
    type: object
    properties:
      displayName?: string

/users/{userId}:
  uriParameters:
    userId: string
  get:
    displayName: getUser
    responses:
      200:
        body:
          type: User
