#%RAML 1.0
title: Test API
uses:
  sunday: https://outfoxx.github.io/sunday-generator/sunday.raml
mediaType:
- application/json

(sunday.placement):
  kotlin:
    package: io.explicit.test
    server:
      package: io.explicit.test.server

/tests/{id}:

  get:
    displayName: fetchTest
    responses:
      200:
        body:
          type: object
          properties:
            value: string
